<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IniMaster</RootNamespace>
    <AssemblyName>INIMaster</AssemblyName>
    <Version>1.2.3</Version>
    <Product>INI Master</Product>
    <Description>Edit Crimson Desert plugin ini files, including while the game runs.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ThemeMode is marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IniMaster.Core\IniMaster.Core.csproj" />
  </ItemGroup>

  <!-- More > Translate INI Master copies this out for translators. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\lang\INIMaster.template.txt" LogicalName="INIMaster.template.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\inimeta\**\*.inimeta" Link="inimeta\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
