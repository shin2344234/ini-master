<Application x:Class="IniMaster.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:IniMaster.Localization"
             xmlns:c="clr-namespace:IniMaster.Controls"
             xmlns:vm="clr-namespace:IniMaster.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <c:VisibleWhenConverter x:Key="Visible" />
            <c:VisibleWhenConverter x:Key="Hidden" Invert="True" />
            <c:NotConverter x:Key="Not" />
            <c:NarrowerThanConverter x:Key="NarrowerThan" />


            <Style x:Key="Secondary" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- A section name: serif, gold, as the menu's Section(). -->
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                <Setter Property="FontSize" Value="17" />
            </Style>

            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="CornerRadius" Value="1" />
                <Setter Property="Padding" Value="8,1,8,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource Frame}" />
                <Setter Property="BorderBrush" Value="{StaticResource BronzeDim}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- The theme styles TextBox by exact type, so the subclass asks for it. -->
            <Style TargetType="c:KeyCaptureBox" BasedOn="{StaticResource {x:Type TextBox}}" />

            <!-- ============================================================ editors -->

            <DataTemplate x:Key="TextEditor" DataType="{x:Type vm:SettingViewModel}">
                <TextBox Width="300" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" />
            </DataTemplate>

            <DataTemplate x:Key="NumberEditor" DataType="{x:Type vm:SettingViewModel}">
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="130" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" />
                    <TextBlock Text="{Binding Unit}" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Secondary}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="SliderEditor" DataType="{x:Type vm:SettingViewModel}">
                <StackPanel Orientation="Horizontal">
                    <Slider Width="170" VerticalAlignment="Center"
                            Minimum="{Binding SliderMin, Mode=OneWay}" Maximum="{Binding SliderMax, Mode=OneWay}"
                            TickFrequency="{Binding SliderStep, Mode=OneWay}" SmallChange="{Binding SliderStep, Mode=OneWay}"
                            LargeChange="{Binding SliderStep, Mode=OneWay}" IsSnapToTickEnabled="{Binding SliderSnaps, Mode=OneWay}"
                            Value="{Binding NumberValue}" />
                    <TextBox Width="96" Margin="10,0,0,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" />
                    <TextBlock Text="{Binding Unit}" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Secondary}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="BoolEditor" DataType="{x:Type vm:SettingViewModel}">
                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BoolCaption}" TextWrapping="Wrap" MaxWidth="300" />
                </CheckBox>
            </DataTemplate>

            <DataTemplate x:Key="EnumEditor" DataType="{x:Type vm:SettingViewModel}">
                <StackPanel Orientation="Horizontal">
                    <ComboBox Width="260" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" DisplayMemberPath="Display" />
                    <TextBox Width="90" Margin="8,0,0,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                             Visibility="{Binding AllowCustom, Converter={StaticResource Visible}}"
                             ToolTip="{l:T 'Any other value. The list covers the ones the comments name.'}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="KeyEditor" DataType="{x:Type vm:SettingViewModel}">
                <StackPanel Orientation="Horizontal">
                    <c:KeyCaptureBox Width="220" Value="{Binding Value}" Format="{Binding KeyFormat}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding ClearKeyCommand}" ToolTip="{l:T 'No key'}" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
